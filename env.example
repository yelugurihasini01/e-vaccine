# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# Healthcare Center Details
CLINIC_NAME=CareWell Immunization & Pediatrics Center
CLINIC_PHONE=+1 (555) 019-2834
CLINIC_EMAIL=vaccines@carewellhealth.org
CLINIC_ADDRESS=104 Health Ave, Medical District, NY

# ===================================================================
# EMAIL REMINDER SETTINGS (Nodemailer)
# ===================================================================
# Set EMAIL_ENABLED=true to send real emails.
# If false or empty credentials, simulated preview links will be logged.
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=CareWell Vaccines <notifications@carewellhealth.org>

# ===================================================================
# WHATSAPP REMINDER SETTINGS
# ===================================================================
# Options: 'simulator' (built-in UI preview), 'twilio' (Twilio API), 'meta' (Cloud API), 'direct' (wa.me link)
WHATSAPP_PROVIDER=simulator

# Twilio Credentials (Required if WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# Meta WhatsApp Cloud API (Required if WHATSAPP_PROVIDER=meta)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=

# ===================================================================
# AUTOMATED REMINDER CRON SETTINGS
# ===================================================================
# Runs every day at 8:00 AM ('0 8 * * *') or every 10 mins ('*/10 * * * *') for testing
CRON_SCHEDULE=0 8 * * *
REMIND_DAYS_BEFORE=7,2,0
ENABLE_AUTO_REMINDERS=true
